{ config, lib, pkgs, mySystem, ... }:

let
  isOled = mySystem.hardware.isOled;
in
{
  home.username = mySystem.username;
  home.homeDirectory = "/home/${mySystem.username}";

  # 1. Native packages
  home.packages = with pkgs; [
    # Desktop & DMS ecosystem utilities
    ghostty
    matugen
    cliphist
    cava
    dgop
    dankcalendar
    adw-gtk3
    kdePackages.qt6ct
    kdePackages.qtmultimedia
    i2c-tools

    # GUI Applications
    vscode
    megasync
    bitwarden-desktop
    keepassxc
    protonvpn-gui

    # CLI & Dev tools
    git-lfs
    delta
    gh
    cosign
    gdb
    strace
    ltrace
    btop
    jq
    tmux
    micro
    gcc
    gnumake
    cmake
    ninja
    ripgrep
    fd
  ];

  # 2. Declarative Flatpaks (auto-removes unmanaged Flatpaks)
  services.flatpak = lib.mkIf mySystem.roles.desktop.enable {
    uninstallUnmanaged = true;
    remotes = [
      {
        name = "flathub";
        location = "https://dl.flathub.org/repo/flathub.flatpakrepo";
      }
      {
        name = "modmanager-origin";
        location = "https://chrisdkn.github.io/Amethyst-Mod-Manager/amethyst.flatpakrepo";
      }
    ];
    packages = [
      "io.github.diegopvlk.Cine"
      "org.gnome.Loupe"
      "org.gnome.Papers"
      "io.github.screwys.Rufin"
      "org.gtk.Gtk3theme.adw-gtk3-dark"
      "com.discordapp.Discord"
      "app.zen_browser.zen"
    ] ++ lib.optionals mySystem.roles.gaming.enable [
      { appId = "io.github.Amethyst.ModManager"; origin = "modmanager-origin"; }
    ];

    # Allow Zen Browser Flatpak to read the dynamic matugen CSS generated by Dux Shell
    overrides."app.zen_browser.zen".Context.filesystems = [
      "xdg-config/dms:ro"
      "xdg-config/DankMaterialShell:ro"
    ];
  };

  # 3. Automatic Zen Browser userChrome.css symlink & about:config setup
  home.activation.configureZenDuxTheme = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    for PROFILE_DIR in \
      "$(find "$HOME/.zen" -maxdepth 1 -type d -name "*.Default*" 2>/dev/null | head -n 1)" \
      "$(find "$HOME/.config/zen" -maxdepth 1 -type d -name "*Default*" 2>/dev/null | head -n 1)" \
      "$(find "$HOME/.var/app/app.zen_browser.zen/.zen" -maxdepth 1 -type d -name "*.Default*" 2>/dev/null | head -n 1)"
    do
      [ -z "$PROFILE_DIR" ] && continue
      mkdir -p "$PROFILE_DIR/chrome"
      ln -sf "$HOME/.config/dms/zen.css" "$PROFILE_DIR/chrome/userChrome.css"

      if ! grep -q "toolkit.legacyUserProfileCustomizations.stylesheets" "$PROFILE_DIR/user.js" 2>/dev/null; then
        echo 'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);' >> "$PROFILE_DIR/user.js"
      fi
    done
  '';

  # 4. OLED conditional tweaks for Niri and Dux Shell
  programs.niri.settings = lib.mkIf mySystem.roles.desktop.enable {
    spawn-at-startup = [
      { command = [ "dms" "run" ]; }
    ];
    # Automatically dim unfocused windows only with OLED screens
    window-rules = lib.mkIf isOled [
      {
        matches = [{ is-focused = false; }];
        opacity = 0.85;
      }
    ];
  };

  # Enforce Dux Shell bar auto-hide on OLED without overwriting your GUI wallpaper choices
  home.activation.configureDuxOled = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    DMS_CONF="$HOME/.config/dms/settings.json"
    if [ -f "$DMS_CONF" ]; then
      ${pkgs.jq}/bin/jq '.barAutoHide = ${if isOled then "true" else "false"}' "$DMS_CONF" > "$DMS_CONF.tmp" \
        && mv "$DMS_CONF.tmp" "$DMS_CONF"
    fi
  '';

  # 5. Declarative Shell & Tooling
  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;
    initContent = ''
      # Passive check if a background NixOS upgrade failed
      if systemctl is-failed --quiet nixos-upgrade.service; then
        echo -e "\033[1;31m[!] Last background NixOS upgrade failed. Check: journalctl -u nixos-upgrade -e\033[0m"
      fi
    '';
  };

  programs.mise = {
    enable = true;
    enableZshIntegration = true;
  };

  programs.starship.enable = true;
  programs.zoxide.enable = true;
  programs.eza.enable = true;
  programs.fzf.enable = true;
  programs.bat.enable = true;
  programs.git.enable = true;

  home.stateVersion = "26.05";
}